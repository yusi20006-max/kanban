{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yusi20006-max/kanban/projects/yasin-chess/board.schema.json",
  "type": "object",
  "required": ["version", "project", "ownerUserId", "columns", "cards"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["key", "name", "repository"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" }
      },
      "additionalProperties": false
    },
    "ownerUserId": { "type": "string", "minLength": 1 },
    "columns": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["position", "id", "name"],
        "properties": {
          "position": { "type": "integer", "minimum": 0, "maximum": 9 },
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "issueNumber", "columnId"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "issueNumber": { "type": "integer", "minimum": 1 },
          "prNumber": { "type": "integer", "minimum": 1 },
          "columnId": { "type": "string", "minLength": 1 },
          "workflowPhases": {
            "type": "array",
            "items": {
              "enum": ["inspect", "implement", "test", "pr", "ci", "merge", "verify", "completed"]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
