{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yusi20006-max/kanban/projects/board.schema.json",
  "title": "Kanban Project Provisioning Configuration",
  "description": "Project-independent configuration used to provision a Kanban board from a GitHub repository.",
  "type": "object",
  "required": ["version", "project", "ownerUserId", "columns", "cards"],
  "properties": {
    "version": { "const": 1 },
    "project": {
      "type": "object",
      "required": ["key", "name", "repository"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        }
      },
      "additionalProperties": false
    },
    "ownerUserId": { "type": "string", "minLength": 1 },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["position", "id", "name"],
        "properties": {
          "position": { "type": "integer", "minimum": 0 },
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "issueNumber", "columnId"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "issueNumber": { "type": "integer", "minimum": 1 },
          "prNumber": { "type": "integer", "minimum": 1 },
          "columnId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "workflowPhases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
